  },
  "keywords": ["obsidian", "plugin", "deepl", "translate"],
  "author": "Luciano Astudillo Baeza",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.20.0",
    "obsidian": "latest",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3"
  }
}
